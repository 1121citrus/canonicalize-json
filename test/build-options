#!/usr/bin/env bash
#
# test/build-options — verify build script CLI option coverage.
#
# Tests that key options are recognized and produce the expected output in
# --dry-run mode; no Docker images are built or pulled.

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
build_script="${repo_root}/build"

fail() {
    echo "[FAIL] $*" >&2
    exit 1
}

contains() {
    local haystack="$1"
    local needle="$2"
    [[ "${haystack}" == *"${needle}"* ]]
}

help_out=$("${build_script}" --help 2>&1)
contains "${help_out}" "--advice" \
    || fail "build --help missing --advice"
contains "${help_out}" "--cache CACHE_RULES" \
    || fail "build --help missing --cache"

adv_out=$("${build_script}" --advice scout \
    --dry-run --no-lint --no-test --no-scan 2>&1)
contains "${adv_out}" "Stage 5b: Advise (Scout)" \
    || fail "--advice scout did not enable Scout advisement"

cache_out=$("${build_script}" --cache "reset=all" \
    --dry-run --no-lint --no-test --no-scan --no-advise 2>&1)
contains "${cache_out}" "Cache: reset Trivy DB" \
    || fail "--cache reset=all missing Trivy reset"
contains "${cache_out}" "Cache: reset Grype DB" \
    || fail "--cache reset=all missing Grype reset"

skip_out=$("${build_script}" --cache "skip-update=all" \
    --dry-run --no-lint --no-test 2>&1)
contains "${skip_out}" "Trivy DB update skipped" \
    || fail "--cache skip-update=all missing Trivy skip message"

echo "[PASS] build option coverage"
